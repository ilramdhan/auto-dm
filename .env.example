# --- Required -------------------------------------------------------------
# Postgres connection string. With the Vercel <-> Supabase integration this is injected
# automatically as POSTGRES_URL (used as a fallback), so you can leave it empty there.
# Supabase: Project settings -> Database -> Connection string -> "Transaction pooler" (port 6543).
DATABASE_URL=
# Optional direct (non-pooled, port 5432) URL used only for running migrations.
DATABASE_URL_UNPOOLED=

# Random string, at least 32 chars. Generate with: openssl rand -base64 48
# Derives the session-signing key and the key that encrypts tokens/secrets in the DB.
# Changing it logs everyone out and makes stored secrets unreadable.
APP_SECRET=

# --- Optional -------------------------------------------------------------
# Public URL of the app. On Vercel this defaults to the production domain.
APP_URL=
# First-run login. You must change the password right after the first login.
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=changeme123
# Required in production for the daily Instagram token refresh (/api/cron/refresh-tokens).
# Vercel sends `Authorization: Bearer $CRON_SECRET` automatically. Generate: openssl rand -hex 32
CRON_SECRET=
