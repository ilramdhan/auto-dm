    {
      "parameters": {
        "jsCode": "// Recover Meta's raw request body (byte-identical) and signature header.\n// For GET (verification) requests there is no body, only query params.\nconst out = [];\nconst items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  const headers = item.json.headers || {};\n  let rawBody = '';\n  if (item.binary && item.binary.data) {\n    const buf = await this.helpers.getBinaryDataBuffer(i, 'data');\n    rawBody = buf.toString('utf8');\n  }\n  out.push({\n    json: {\n      isVerification: !rawBody,\n      query: item.json.query || {},\n      signature: headers['x-hub-signature-256'] || '',\n      rawBody,\n    },\n  });\n}\nreturn out;"
      },
      "id": "5f3f0a51-0012-4a00-8000-000000000012",
      "name": "Extract raw body + signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [60, 360]
    },
